# 이 파일을 .env로 복사한 뒤 실제 운영 값을 채웁니다. .env와 비밀값은 커밋하지 않습니다.
# Docker Compose로 실행하면 app 서비스의 DB_URL·DB_USERNAME·DB_PASSWORD는 아래 PostgreSQL 값으로 덮어씁니다.

# 필수 (운영 환경)
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL / Docker Compose
POSTGRES_DB=haemi
POSTGRES_USER=haemi
# 반드시 강력한 값으로 교체합니다. Docker Compose는 이 값을 요구합니다.
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_PORT=5432

# Docker Compose 없이 애플리케이션을 직접 실행할 때 사용하는 DB 연결 정보
DB_URL=jdbc:postgresql://localhost:5432/haemi
DB_USERNAME=haemi
DB_PASSWORD=replace-with-strong-password

# 인증·암호화
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Generate 32 bytes with: openssl rand -base64 32
ELDER_HEALTH_ENCRYPTION_KEY=

# 필수 (운영 이메일)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
APP_PUBLIC_URL=https://api.example.com

# 필수 (운영 스토리지 — S3 또는 S3 호환 R2)
# access-key/secret-key를 비우면 EC2 인스턴스 역할 등 AWS 기본 자격증명 체인을 사용합니다.
S3_BUCKET=
S3_REGION=ap-northeast-2
# S3 호환 스토리지(Cloudflare R2 등)에 붙을 때만 지정합니다. AWS S3면 비웁니다.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# R2 등 일부 스토리지는 path-style 접근이 필요합니다.
S3_PATH_STYLE_ACCESS=false
S3_PRESIGNED_PUT_EXPIRY=PT15M
S3_SERVING_URL_EXPIRY=PT1H

# FCM 푸시를 사용할 때 설정합니다.
# 서비스 계정 JSON 원문 또는 app 컨테이너에서 접근 가능한 JSON 파일 경로를 넣습니다.
# 파일 경로를 쓸 경우 docker-compose.yml에 해당 파일을 컨테이너로 마운트해야 합니다.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# 선택 (Gemini 회상 카드 생성·시 초안·음성 전사)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_CONNECT_TIMEOUT=5s
GEMINI_READ_TIMEOUT=20s
GEMINI_INLINE_AUDIO_MAX_BYTES=12582912
GEMINI_MAX_CONCURRENT_AUDIO_REQUESTS=2

# Docker 이미지와 포트
APP_PORT=8080
DOCKER_IMAGE=your-dockerhub-user/haemi-server:latest

# Flyway
# 신규 DB에서는 기본값(false)을 유지합니다.
# 기존 스키마에 Flyway 이력이 없다면 적용된 마지막 버전을 확인한 뒤 두 값을 함께 지정합니다.
FLYWAY_BASELINE_ON_MIGRATE=false
# FLYWAY_BASELINE_VERSION=111

# OpenAPI / JPA
OPENAPI_SERVER_URL=https://api.example.com
# 개발 프로필에서만 사용합니다. prod 프로필은 로컬 서버 표기를 항상 숨깁니다.
OPENAPI_LOCAL_SERVER_URL=http://localhost:8080
OPENAPI_INCLUDE_LOCAL_SERVER=true
JPA_SHOW_SQL=false
# 운영에서는 API 문서 공개를 기본적으로 끕니다.
API_DOCS_ENABLED=false

# 선택 (도메인 설정 오버라이드)
HAEMI_FAMILY_MAX_ELDERS=4
HAEMI_FAMILY_MAX_GUARDIANS=8
HAEMI_MEDIA_IMAGE_MAX_SIZE_BYTES=10485760
HAEMI_MEDIA_IMAGE_MEMORY_MAX_COUNT=4
HAEMI_MEDIA_IMAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif
# HEIC 서버 변환 (libheif-tools의 heif-convert 또는 ImageMagick의 magick). Docker 이미지에 바이너리 포함.
HAEMI_MEDIA_HEIC_ENABLED=true
HAEMI_MEDIA_HEIC_COMMAND=heif-convert
HAEMI_MEDIA_HEIC_TIMEOUT=PT20S
HAEMI_MEDIA_VOICE_MAX_SIZE_BYTES=12582912
HAEMI_MEDIA_VOICE_MAX_DURATION_SECONDS=60
HAEMI_MEDIA_VOICE_ALLOWED_TYPES=audio/aac,audio/mp4,audio/webm,audio/ogg
HAEMI_MEDIA_PROFILE_MAX_SIZE_BYTES=5242880
HAEMI_MEDIA_PROFILE_ALLOWED_TYPES=image/jpeg,image/png,image/webp
HAEMI_MEDIA_PRESIGNED_URL_EXPIRY=PT15M
HAEMI_MEDIA_RETENTION_MEMORY_DAYS=365
HAEMI_MEDIA_RETENTION_RESPONSE_DAYS=365
HAEMI_DAILYCARE_RETENTION_DAYS=30
HAEMI_DAILYCARE_INBOX_LOOKBACK_DAYS=30
HAEMI_DAILYCARE_MAX_VOICE_SECONDS=60
