# 필수 (운영 환경)
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://localhost:5432/haemi
DB_USERNAME=haemi
DB_PASSWORD=
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Generate 32 bytes with: openssl rand -base64 32
ELDER_HEALTH_ENCRYPTION_KEY=

# 선택 (기관 관리자 가입 허용 이메일, 쉼표 구분 - 미설정 시 아무도 가입 불가)
# 가입 후에도 2FA 등록을 마쳐야 로그인할 수 있다.
INSTITUTION_ADMIN_EMAILS=

# 필수 (prod FCM 푸시 알림)
# 서비스 계정 JSON 원문 또는 JSON 파일 경로.
# 운영 배포는 GitHub Secret의 JSON을 secrets/firebase-service-account.json 파일로 떨어뜨리고
# 이 값에는 컨테이너 안 경로(/run/secrets/firebase-service-account.json)를 넣는다.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# 필수 (prod 이메일 확인 링크 SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
APP_PUBLIC_URL=https://api.example.com

# 선택 (Gemini 회상 카드 생성·M2 시 초안·음성 전사)
# M2의 시 초안·음성 전사는 키가 없으면 고정 문구 대신 503을 반환한다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Gemini inlineData 20MB 제한과 base64/JSON 버퍼 여유를 고려한 음성 원본 최대 크기
GEMINI_INLINE_AUDIO_MAX_BYTES=12MB
# 동시 음성 전사 수. 12MB 요청의 힙 사용량을 제한한다.
GEMINI_MAX_CONCURRENT_AUDIO_REQUESTS=2
# 전역 multipart 한도. 사진 업로드는 파일당 20MB, 최대 30장을 지원한다.
MULTIPART_MAX_FILE_SIZE=20MB
MULTIPART_MAX_REQUEST_SIZE=650MB

# 선택 (로컬 Docker PostgreSQL 초기화용 - 외부 DB 사용 시 불필요)
POSTGRES_DB=haemi
POSTGRES_USER=haemi
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# 선택 (애플리케이션/OpenAPI 서버 주소)
APP_PORT=8080
OPENAPI_SERVER_URL=

# 선택 (EC2 배포 시 Docker Hub 이미지 태그)
DOCKER_IMAGE=your-dockerhub-user/haemi-server:latest
# 기존 DB에 V100+ 마이그레이션이 이미 적용된 경우 true (신규 환경에서는 false)
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1

# 선택 (API 문서 공개 여부 - 기본 true)
# true면 Swagger UI와 /v3/api-docs가 인증 없이 열려 전체 API 표면이 공개된다.
# 클라이언트 개발 중에는 켜 두고, 정식 오픈 시점에 false로 바꾼다. 재배포만 하면 되고 코드 변경은 없다.
API_DOCS_ENABLED=true
